---
import { Image } from 'astro:assets';
import icon from '../assets/icon.png';
import { githubRepositoryLink, type LandingContent, type Locale } from '../i18n/content';
import GitHubIcon from './GitHubIcon.astro';
import LanguageSelector from './LanguageSelector.astro';

interface Props {
  locale: Locale;
  content: Pick<LandingContent, 'accessibility' | 'nav'>;
}

const { locale, content } = Astro.props;

const navItems = [
  { href: '#index', label: content.nav.home },
  { href: '#download', label: content.nav.download },
  { href: '#app-features', label: content.nav.features },
  { href: '#privacy', label: content.nav.privacy },
  { href: '#terms', label: content.nav.terms },
];
---

<a
  class="fixed inset-s-4 top-4 z-350 -translate-y-24 rounded-full bg-ink px-4 py-2 text-sm font-semibold text-paper-on-dark transition-transform duration-200 focus:translate-y-0 focus:outline-none"
  href="#content"
>
  {content.accessibility.skipToContent}
</a>

<header
  class="fixed inset-s-1/2 top-3 z-300 w-[calc(100%-2.5rem)] max-w-232 -translate-x-1/2 rounded-full border border-rule bg-nav-surface shadow-nav backdrop-blur-2xl nav:top-4"
  data-header
>
  <div class="flex min-h-16 items-center justify-between gap-3 px-3 py-2 nav:px-4">
    <a
      class="flex min-h-11 shrink-0 items-center gap-2 whitespace-nowrap rounded-full"
      href="#index"
      aria-label={content.accessibility.brandHome}
    >
      <Image
        class="size-8"
        src={icon}
        alt=""
        width={32}
        height={32}
      />
      <span class="font-wordmark text-xl font-bold leading-none tracking-[-0.04em]">
        Cash <span class="text-accent-strong">IO</span>
      </span>
    </a>

    <button
      class="flex size-11 shrink-0 cursor-pointer flex-col items-center justify-center gap-1 rounded-full border border-ink bg-ink p-0 text-paper transition-transform duration-150 active:scale-[0.97] nav:hidden"
      type="button"
      aria-label={content.accessibility.openNavigation}
      aria-controls="site-nav"
      aria-expanded="false"
      data-open-label={content.accessibility.openNavigation}
      data-close-label={content.accessibility.closeNavigation}
      data-nav-toggle
    >
      <span class="h-0.5 w-4.5 rounded-full bg-current transition-transform duration-200 ease-cash-in-out"></span>
      <span class="h-0.5 w-4.5 rounded-full bg-current transition-opacity duration-200 ease-cash-in-out"></span>
      <span class="h-0.5 w-4.5 rounded-full bg-current transition-transform duration-200 ease-cash-in-out"></span>
    </button>

    <nav
      class="site-nav invisible pointer-events-none absolute inset-x-0 top-[calc(100%+0.5rem)] grid -translate-y-2 gap-1 rounded-lg border border-rule bg-paper p-2 opacity-0 shadow-nav transition-[opacity,transform] duration-200 ease-cash-out nav:visible nav:pointer-events-auto nav:static nav:flex nav:translate-y-0 nav:items-center nav:gap-1 nav:border-0 nav:bg-transparent nav:p-0 nav:opacity-100 nav:shadow-none"
      id="site-nav"
      aria-label={content.accessibility.primaryNavigation}
      data-nav
    >
      {
        navItems.map((item, index) => (
          <a
            class="flex min-h-11 items-center rounded-sm px-4 text-sm font-semibold whitespace-nowrap text-muted transition-colors duration-200 hover:bg-paper-2 hover:text-ink aria-[current=location]:bg-accent-soft aria-[current=location]:text-ink nav:min-h-10 nav:px-3"
            href={item.href}
            aria-current={index === 0 ? 'location' : undefined}
          >
            {item.label}
          </a>
        ))
      }
      <a
        class="inline-flex size-11 shrink-0 items-center justify-center justify-self-start rounded-full text-muted transition-[background-color,color,transform] duration-200 ease-cash-out hover:-translate-y-px hover:bg-paper-2 hover:text-ink active:translate-y-px nav:size-10"
        href={githubRepositoryLink.href}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={content.accessibility.githubRepository}
      >
        <GitHubIcon class="size-5" />
      </a>
      <LanguageSelector
        locale={locale}
        label={content.accessibility.languageSelector}
      />
    </nav>
  </div>
</header>

<style>
  .site-nav.is-open {
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0);
    opacity: 1;
  }

  :global(body.nav-open) {
    overflow-y: clip;
  }

  :global(.nav-open) [data-nav-toggle] span:nth-child(1) {
    transform: translateY(0.375rem) rotate(45deg);
  }

  :global(.nav-open) [data-nav-toggle] span:nth-child(2) {
    opacity: 0;
  }

  :global(.nav-open) [data-nav-toggle] span:nth-child(3) {
    transform: translateY(-0.375rem) rotate(-45deg);
  }
</style>

<script>
  const body = document.body;
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const nav = document.querySelector<HTMLElement>('[data-nav]');
  const header = document.querySelector<HTMLElement>('[data-header]');
  const navLinks = [
    ...document.querySelectorAll<HTMLAnchorElement>(
      '[data-nav] a[href^="#"]',
    ),
  ];
  const sections = navLinks
    .map((link) => document.querySelector(link.getAttribute('href') ?? ''))
    .filter((section): section is Element => section !== null);

  function setNavOpen(isOpen: boolean) {
    if (!toggle || !nav) {
      return;
    }

    body.classList.toggle('nav-open', isOpen);
    nav.classList.toggle('is-open', isOpen);
    toggle.setAttribute('aria-expanded', String(isOpen));
    toggle.setAttribute(
      'aria-label',
      isOpen
        ? (toggle.dataset.closeLabel ?? '')
        : (toggle.dataset.openLabel ?? ''),
    );
  }

  toggle?.addEventListener('click', () => {
    setNavOpen(toggle.getAttribute('aria-expanded') !== 'true');
  });

  nav?.addEventListener('click', (event) => {
    if (event.target instanceof HTMLAnchorElement) {
      setNavOpen(false);
    }
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      setNavOpen(false);
      toggle?.focus();
    }
  });

  document.addEventListener('click', (event) => {
    if (
      body.classList.contains('nav-open') &&
      event.target instanceof Node &&
      !header?.contains(event.target)
    ) {
      setNavOpen(false);
    }
  });

  if ('IntersectionObserver' in window) {
    const navigationObserver = new IntersectionObserver(
      (entries) => {
        const visibleEntry = entries
          .filter((entry) => entry.isIntersecting)
          .sort(
            (first, second) =>
              second.intersectionRatio - first.intersectionRatio,
          )[0];

        if (!visibleEntry) {
          return;
        }

        navLinks.forEach((link) => {
          const isCurrent =
            link.getAttribute('href') === `#${visibleEntry.target.id}`;

          if (isCurrent) {
            link.setAttribute('aria-current', 'location');
          } else {
            link.removeAttribute('aria-current');
          }
        });
      },
      {
        rootMargin: '-20% 0px -65%',
        threshold: [0, 0.25, 0.5],
      },
    );

    sections.forEach((section) => navigationObserver.observe(section));
  }

  const desktopNavigation = window.matchMedia('(min-width: 52rem)');
  desktopNavigation.addEventListener('change', (event) => {
    if (event.matches) {
      setNavOpen(false);
    }
  });
</script>
