---
import {
  languageLabels,
  localeStorageKey,
  locales,
  type Locale,
} from '../i18n/content';

interface Props {
  locale: Locale;
  label: string;
}

const { locale, label } = Astro.props;
---

<label
  class="relative flex min-h-11 items-center rounded-full border border-rule bg-paper text-sm font-semibold text-ink transition-colors duration-200 ease-cash-out hover:bg-paper-2"
>
  <span class="sr-only">{label}</span>
  <select
    class="min-h-11 cursor-pointer appearance-none rounded-full bg-transparent py-2 ps-4 pe-9 text-base nav:text-sm"
    aria-label={label}
    data-language-select
    data-storage-key={localeStorageKey}
  >
    {
      locales.map((optionLocale) => (
        <option value={optionLocale} selected={optionLocale === locale}>
          {languageLabels[optionLocale]}
        </option>
      ))
    }
  </select>
  <svg
    class="pointer-events-none absolute inset-e-3 size-4"
    viewBox="0 0 20 20"
    fill="none"
    aria-hidden="true"
  >
    <path
      d="m6 8 4 4 4-4"
      stroke="currentColor"
      stroke-width="1.75"
      stroke-linecap="round"
      stroke-linejoin="round"></path>
  </svg>
</label>

<script>
  const supportedLocales = new Set(['es', 'en', 'pt']);

  document
    .querySelectorAll<HTMLSelectElement>('[data-language-select]')
    .forEach((select) => {
      select.addEventListener('change', () => {
        const nextLocale = select.value;

        if (!supportedLocales.has(nextLocale)) {
          return;
        }

        const storageKey = select.dataset.storageKey;

        if (storageKey) {
          try {
            window.localStorage.setItem(storageKey, nextLocale);
          } catch {
            // Language navigation still works when storage is unavailable.
          }
        }

        const target = `/${nextLocale}/${window.location.search}${window.location.hash}`;
        window.location.assign(target);
      });
    });
</script>
