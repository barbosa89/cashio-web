---
import { Image } from 'astro:assets';
import heroImage from '../assets/hero-1.webp';
import type { LandingContent } from '../i18n/content';

interface Props {
  content: Pick<LandingContent, 'accessibility' | 'hero'>;
}

const { content } = Astro.props;
---

<section
  class="mx-auto grid max-w-296 gap-10 px-4 pt-34 pb-24 content:px-10 wide:min-h-0 wide:grid-cols-[minmax(20rem,0.85fr)_minmax(0,1.35fr)] wide:items-center wide:gap-16 wide:pt-24 wide:pb-36 canvas:gap-24"
  id="index"
>
  <div class="grid min-w-0 content-center gap-6">
    <h1 class="max-w-[11ch] text-display-small leading-[0.98] text-balance">
      {content.hero.title}
    </h1>
    <p
      class="max-w-140 text-[clamp(1rem,2vw,1.25rem)] leading-[1.55] text-muted"
    >
      {content.hero.lead}
    </p>
    <div class="flex flex-col items-start gap-3 content:flex-row content:flex-wrap">
      <a
        class="inline-flex min-h-12 items-center justify-center whitespace-nowrap rounded-full border border-ink bg-ink px-6 font-bold text-paper transition-[background-color,transform] duration-200 ease-cash-out hover:-translate-y-px hover:bg-ink-2 active:translate-y-px"
        href="#download"
      >
        {content.hero.primaryAction}
      </a>
      <a
        class="inline-flex min-h-12 items-center justify-center whitespace-nowrap rounded-full border border-rule-strong bg-paper px-6 font-bold text-ink transition-[background-color,transform] duration-200 ease-cash-out hover:-translate-y-px hover:bg-paper-2 active:translate-y-px"
        href="#app-features"
      >
        {content.hero.secondaryAction}
      </a>
    </div>
  </div>

  <figure
    class="aspect-square min-w-0 self-center overflow-hidden wide:aspect-5/4 wide:w-[calc(100%+8vw)] wide:max-h-128"
    aria-label={content.accessibility.heroImage}
  >
    <Image
      class="size-full object-contain"
      src={heroImage}
      alt={content.accessibility.heroImage}
      loading="eager"
      fetchpriority="high"
      widths={[640, 960, 1200]}
      sizes="(min-width: 60rem) 60vw, 100vw"
    />
  </figure>
</section>
