---
import type { LandingContent } from '../i18n/content';

interface Props {
  content: Pick<LandingContent, 'accessibility' | 'download'>;
}

const { content } = Astro.props;
---

<section
  class="mx-auto grid max-w-296 items-start gap-10 border-y border-rule px-4 py-16 content:grid-cols-[minmax(0,1fr)_auto] content:items-center content:px-10"
  id="download"
>
  <div class="grid min-w-0 gap-4">
    <p class="flex max-w-none items-center gap-2 text-sm font-semibold text-ink-2">
      <span class="size-2 shrink-0 rounded-full bg-accent" aria-hidden="true"></span>
      {content.download.availability}
    </p>
    <h2 class="text-[clamp(2.441rem,5vw,3.052rem)] leading-[1.02] text-balance">
      {content.download.title}
    </h2>
    <p class="text-muted">{content.download.description}</p>
  </div>

  <a
    class="inline-flex min-h-14 items-center gap-3 self-start whitespace-nowrap rounded-full border border-rule-strong bg-paper py-2 ps-3 pe-6 text-ink transition-[background-color,transform] duration-200 ease-cash-out hover:-translate-y-px hover:bg-paper-2 active:translate-y-px"
    href="https://play.google.com/store/apps/details?id=com.omarbarbosa.cashio"
    aria-label={content.accessibility.playStore}
  >
    <span
      class="flex size-10 items-center justify-center rounded-full bg-accent-soft text-accent-strong"
      aria-hidden="true"
    >
      <svg class="size-5" viewBox="0 0 32 32"><path fill="currentColor" d="M5 3.75v24.5L25.5 16z"/></svg>
    </span>
    <span>
      <small class="block text-xs font-semibold text-muted">
        {content.download.storeCaption}
      </small>
      <strong class="block text-xl leading-[1.1]">
        {content.download.storeName}
      </strong>
    </span>
  </a>
</section>
