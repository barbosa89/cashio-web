---
import icon from "../assets/icon.png";
import "../styles/global.css";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <meta name="robots" content="noindex, follow" />
    <meta name="theme-color" content="#f97316" />
    <title>Cash IO</title>
    <link rel="icon" href={icon.src} />
    <link rel="alternate" hreflang="es" href="/es/" />
    <link rel="alternate" hreflang="en" href="/en/" />
    <link rel="alternate" hreflang="pt" href="/pt/" />
    <link rel="alternate" hreflang="x-default" href="/" />

    <script is:inline>
      (() => {
        const supportedLocales = ["es", "en", "pt"];

        const normalizeLocale = (value) => {
          if (typeof value !== "string") {
            return null;
          }

          const primaryLocale = value.trim().toLowerCase().split("-")[0];
          return supportedLocales.includes(primaryLocale)
            ? primaryLocale
            : null;
        };

        let selectedLocale = null;

        try {
          selectedLocale = normalizeLocale(
            window.localStorage.getItem("cashio:locale"),
          );
        } catch {
          // Continue with the browser preference when storage is unavailable.
        }

        if (!selectedLocale) {
          const browserLocales =
            navigator.languages?.length > 0
              ? navigator.languages
              : [navigator.language];

          selectedLocale =
            browserLocales.map(normalizeLocale).find(Boolean) ?? "es";
        }

        window.location.replace(
          `/${selectedLocale}/${window.location.search}${window.location.hash}`,
        );
      })();
    </script>

    <noscript>
      <meta http-equiv="refresh" content="0;url=/es/" />
    </noscript>
  </head>
  <body>
    <main class="grid min-h-dvh place-items-center px-6 py-16 text-center">
      <div class="grid max-w-lg gap-6">
        <p class="font-display text-4xl font-bold tracking-[-0.035em]">
          Cash <span class="text-accent-strong">IO</span>
        </p>
        <h1 class="text-2xl leading-tight">Choose your language</h1>
        <nav class="flex flex-wrap justify-center gap-3" aria-label="Languages">
          <a
            class="rounded-full border border-rule-strong px-5 py-3 font-semibold hover:bg-paper-2"
            href="/es/">Spanish</a
          >
          <a
            class="rounded-full border border-rule-strong px-5 py-3 font-semibold hover:bg-paper-2"
            href="/en/">English</a
          >
          <a
            class="rounded-full border border-rule-strong px-5 py-3 font-semibold hover:bg-paper-2"
            href="/pt/">Portuguese</a>
          >
        </nav>
      </div>
    </main>
  </body>
</html>
